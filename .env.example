# Donum QMS print agent — copy this file to ".env" and fill it in.

# WebSocket endpoint of the Donum QMS backend. Must end in /ws/print.
# Use ws:// for plain HTTP, wss:// for HTTPS.
CLOUD_WS_URL=ws://localhost:8000/ws/print

# A tenant API key, created in the Donum tenant app (API Keys screen).
# This both authenticates the agent and tells the backend which tenant's
# print jobs to send it. Keep it secret — do not commit the real .env.
AGENT_API_KEY=

# Windows printer name, exactly as shown in "Printers & scanners".
# Leave blank to use the system default printer.
PRINTER_NAME=E-PoS printer driver

# Optional. INFO (default) or DEBUG.
LOG_LEVEL=INFO

# Optional. Seconds between "link alive" heartbeat lines in the log.
HEARTBEAT_SECONDS=60
